# NovaSync — Supabase credentials
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.
#
# Setup steps:
# 1. Create .env.local with your Supabase credentials
# 2. Supabase Dashboard > SQL Editor → run supabase/schema.sql
# 3. Supabase Dashboard > SQL Editor → run supabase/seed.sql (30 products)
# 4. n8n > Import Workflow → n8n/Proyecton8n.json
# 5. Configure Google Sheets + Slack credentials in n8n
# 6. npm run dev

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
