    {
      "parameters": {
        "jsCode": "const lead = $('🎯 ¿Score ≥ 8 y Compró?').first().json;\nconst inventario = $input.first().json;\n\nconst webhook = lead.body || lead;\n\nconst stockActual = parseInt(inventario['Stock Actual']) || 0;\nconst stockMinimo = parseInt(inventario['Stock Mínimo']) || 0;\nconst proveedor = inventario['Proveedor'] || 'Sin proveedor';\nconst producto = inventario['Producto'] || webhook.Producto_Comprado || 'Sin producto';\nconst codigo = inventario['Código'] || 'N/A';\nconst cantidad = webhook.Cantidad || 1;\nconst total = webhook.Total || 0;\n\nconst stockBajo = stockActual < stockMinimo;\nconst stockUrgente = stockActual < 5;\nconst estadoStock = stockUrgente ? '🔴 CRÍTICO' : (stockBajo ? '🟡 BAJO' : '🟢 OK');\n\nconst fechaHora = new Date().toLocaleString('es-CO', { timeZone: 'America/Bogota' });\nconst fecha = new Date().toLocaleDateString('es-CO');\nconst hora = new Date().toLocaleTimeString('es-CO');\n\nconst separador = '───────────────────────';\n\nconst mensajeTrue = [\n  `🚨 *ALERTA — Stock Crítico + Venta Premium*`,\n  separador,\n  `👤 *Cliente:* ${webhook.nombre || 'Sin nombre'}`,\n  `🏢 *Empresa:* ${webhook.empresa || 'Sin empresa'}`,\n  `💼 *Cargo:* ${webhook.cargo || 'Sin cargo'}`,\n  `📧 *Email:* ${webhook.email || 'Sin email'}`,\n  `⭐ *Score IA:* ${webhook.Score_IA || 0}/10`,\n  ``,\n  `📦 *Producto:* ${producto}`,\n  `🔢 *Cantidad vendida:* ${cantidad} unidad(es)`,\n  `💰 *Total venta:* $${Math.round(total).toLocaleString('es-CO')}`,\n  `📍 *Código:* ${codigo}`,\n  ``,\n  `📊 *Estado del inventario:*`,\n  `• Stock tras venta: ${stockActual} uds`,\n  `• Stock mínimo: ${stockMinimo} uds`,\n  `• Estado: ${estadoStock}`,\n  ``,\n  `🏭 *Proveedor:* ${proveedor}`,\n  `🕐 *Fecha:* ${fecha} — ${hora}`,\n  separador,\n  `⚠️ _Se generará orden de recompra automáticamente_`\n].join('\\n');\n\nconst mensajeFalse = [\n  `✅ *Venta Premium Convertida*`,\n  separador,\n  `👤 *Cliente:* ${webhook.nombre || 'Sin nombre'}`,\n  `🏢 *Empresa:* ${webhook.empresa || 'Sin empresa'}`,\n  `💼 *Cargo:* ${webhook.cargo || 'Sin cargo'}`,\n  `📧 *Email:* ${webhook.email || 'Sin email'}`,\n  `⭐ *Score IA:* ${webhook.Score_IA || 0}/10`,\n  ``,\n  `📦 *Producto:* ${producto}`,\n  `🔢 *Cantidad vendida:* ${cantidad} unidad(es)`,\n  `💰 *Total venta:* $${Math.round(total).toLocaleString('es-CO')}`,\n  `📍 *Código:* ${codigo}`,\n  ``,\n  `📊 *Estado del inventario:*`,\n  `• Stock tras venta: ${stockActual} uds`,\n  `• Stock mínimo: ${stockMinimo} uds`,\n  `• Estado: ${estadoStock}`,\n  ``,\n  `🏭 *Proveedor:* ${proveedor}`,\n  `🕐 *Fecha:* ${fecha} — ${hora}`,\n  separador,\n  `✅ _Stock en rango normal. No se requiere reabastecimiento._`\n].join('\\n');\n\nreturn [{\n  json: {\n    leadNombre: webhook.nombre || 'Sin nombre',\n    leadEmpresa: webhook.empresa || 'Sin empresa',\n    leadEmail: webhook.email || '',\n    leadCargo: webhook.cargo || '',\n    leadScore: webhook.Score_IA || 0,\n    leadCategoria: webhook.Categoria || 'otro',\n    leadIndustria: webhook.Industria || 'otro',\n    producto,\n    codigo,\n    proveedor,\n    stockActual,\n    stockMinimo,\n    cantidad,\n    total,\n    stockBajo,\n    stockUrgente,\n    estadoStock,\n    generarOrden: stockBajo,\n    mensajeSlack: stockBajo ? mensajeTrue : mensajeFalse,\n    mensajeFinal: stockBajo ? mensajeTrue : mensajeFalse,\n    fechaHora,\n    fecha,\n    hora\n  }\n}];"
      },
