    {
      "parameters": {
        "jsCode": "const geminiResponse = $input.first().json;\nconst prevData = $('⚙️ Preparar Prompt Alerta').first().json;\n\nconst mensajeIA = (geminiResponse.text || geminiResponse.candidates?.[0]?.content?.parts?.[0]?.text || '').trim();\nconst mensajeFinal = prevData.mensajeSlack + (mensajeIA ? '\\n\\n💡 *Análisis IA:*\\n' + mensajeIA : '');\n\nreturn [{ json: { ...prevData, mensajeFinal } }];"
      },
