    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\n\nconst stockActual = lead.Stock_Actual || 0;\nconst stockMinimo = lead.Stock_Minimo || 0;\nconst proveedor = lead.Proveedor || 'Sin proveedor';\nconst producto = lead.Producto_Comprado || 'Sin producto';\nconst codigo = lead.Codigo || 'N/A';\nconst cantidad = lead.Cantidad || 1;\nconst total = lead.Total || 0;\n\nconst stockBajo = stockActual < stockMinimo;\nconst stockUrgente = stockActual < 5;\nconst estadoStock = stockUrgente ? '🔴 CRÍTICO' : (stockBajo ? '🟡 BAJO' : '🟢 OK');\n\nconst fechaHora = new Date().toLocaleString('es-CO', { timeZone: 'America/Bogota' });\nconst fecha = new Date().toLocaleDateString('es-CO');\nconst hora = new Date().toLocaleTimeString('es-CO');\n\nconst sep = '───────────────────────';\n\nconst msgCritico = [\n  '🚨 *ALERTA — Stock Crítico + Venta Premium*',\n  sep,\n  `👤 *Cliente:* ${lead.nombre || 'Sin nombre'}`,\n  `🏢 *Empresa:* ${lead.empresa || 'Sin empresa'}`,\n  `💼 *Cargo:* ${lead.cargo || 'Sin cargo'}`,\n  `📧 *Email:* ${lead.email || 'Sin email'}`,\n  `⭐ *Score IA:* ${lead.Score_IA || 0}/10`,\n  '',\n  `📦 *Producto:* ${producto}`,\n  `🔢 *Cantidad vendida:* ${cantidad} unidad(es)`,\n  `💰 *Total venta:* $${Math.round(total).toLocaleString('es-CO')}`,\n  `📍 *Código:* ${codigo}`,\n  '',\n  '📊 *Estado del inventario:*',\n  `• Stock tras venta: ${stockActual} uds`,\n  `• Stock mínimo: ${stockMinimo} uds`,\n  `• Estado: ${estadoStock}`,\n  '',\n  `🏭 *Proveedor:* ${proveedor}`,\n  `🕐 *Fecha:* ${fecha} — ${hora}`,\n  sep,\n  '⚠️ _Se generará orden de recompra automáticamente_'\n].join('\\n');\n\nconst msgOk = [\n  '✅ *Venta Premium Convertida*',\n  sep,\n  `👤 *Cliente:* ${lead.nombre || 'Sin nombre'}`,\n  `🏢 *Empresa:* ${lead.empresa || 'Sin empresa'}`,\n  `💼 *Cargo:* ${lead.cargo || 'Sin cargo'}`,\n  `📧 *Email:* ${lead.email || 'Sin email'}`,\n  `⭐ *Score IA:* ${lead.Score_IA || 0}/10`,\n  '',\n  `📦 *Producto:* ${producto}`,\n  `🔢 *Cantidad vendida:* ${cantidad} unidad(es)`,\n  `💰 *Total venta:* $${Math.round(total).toLocaleString('es-CO')}`,\n  `📍 *Código:* ${codigo}`,\n  '',\n  '📊 *Estado del inventario:*',\n  `• Stock tras venta: ${stockActual} uds`,\n  `• Stock mínimo: ${stockMinimo} uds`,\n  `• Estado: ${estadoStock}`,\n  '',\n  `🏭 *Proveedor:* ${proveedor}`,\n  `🕐 *Fecha:* ${fecha} — ${hora}`,\n  sep,\n  '✅ _Stock en rango normal. No se requiere reabastecimiento._'\n].join('\\n');\n\nreturn [{\n  json: {\n    leadNombre: lead.nombre || 'Sin nombre',\n    leadEmpresa: lead.empresa || 'Sin empresa',\n    leadEmail: lead.email || '',\n    leadCargo: lead.cargo || '',\n    leadScore: lead.Score_IA || 0,\n    producto,\n    codigo,\n    proveedor,\n    stockActual,\n    stockMinimo,\n    cantidad,\n    total,\n    stockBajo,\n    stockUrgente,\n    estadoStock,\n    generarOrden: stockBajo,\n    mensajeSlack: stockBajo ? msgCritico : msgOk,\n    mensajeFinal: stockBajo ? msgCritico : msgOk,\n    fechaHora,\n    fecha,\n    hora\n  }\n}];"
      },
