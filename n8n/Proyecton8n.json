    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst prompt = `Eres un asistente experto en gestión de inventario y ventas B2B en Colombia.\n\nAcabas de procesar una venta a un cliente premium. El stock del producto vendido bajó del mínimo requerido. Genera un mensaje ejecutivo de Slack (máximo 5 líneas, formato bullet points con emojis) que resuma:\n1. La oportunidad de negocio (cliente + industria)\n2. El estado crítico del inventario\n3. La acción inmediata recomendada al equipo\n\nUsa un tono profesional pero urgente. El mensaje debe motivar al equipo a actuar rápido.\n\nDATOS:\n- Cliente: ${item.leadNombre} — ${item.leadEmpresa}\n- Industria: ${item.leadIndustria}\n- Score Lead: ${item.leadScore}/10\n- Producto: ${item.producto} (${item.codigo})\n- Stock actual: ${item.stockActual} unidades\n- Stock mínimo: ${item.stockMinimo} unidades\n- Proveedor: ${item.proveedor}\n- Estado: ${item.estadoStock}\n\nResponde SOLO con el mensaje de Slack, sin comillas ni texto adicional.`;\n\nconst geminiBody = JSON.stringify({\n  contents: [{ parts: [{ text: prompt }] }],\n  generationConfig: { temperature: 0.4, maxOutputTokens: 400 }\n});\n\nreturn [{ json: { ...item, prompt, geminiBody } }];"
      },
      "id": "500410b2-dbd6-4f7c-9881-46be608eb404",
      "name": "⚙️ Preparar Prompt Alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const geminiResponse = $input.first().json;\nconst prevData = $('⚙️ Preparar Prompt Alerta').first().json;\n\nlet mensajeIA = '';\ntry {\n  mensajeIA = geminiResponse.candidates?.[0]?.content?.parts?.[0]?.text || '';\n} catch(e) {\n  mensajeIA = prevData.mensajeSlack;\n}\n\nconst mensajeFinal = mensajeIA.trim() || prevData.mensajeSlack;\n\nreturn [{ json: { ...prevData, mensajeFinal } }];"
      },
