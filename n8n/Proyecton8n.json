      "id": "05a27ec8-c57c-42c7-926d-43bded140b8b",
      "name": "🔍 Consultar Stock Actual",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -200,
        580
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
